# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
eggs/
dist/
build/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST
*.manifest
*.spec

# Virtual environments (non-hidden names)
venv/
ENV/
env/

# Test / coverage outputs
htmlcov/
coverage.xml
*.cover

# Packaging leftovers
src/*.egg-info/

# --- Secrets ---
*.pem
*.key
credentials.json
secrets/

# --- Editor junk ---
*.swp
*.swo
*~
Thumbs.db

# --- Hidden files/dirs (local tooling, envs, caches, IDE) ---
# Do not track dotfiles. Un-ignore only what must be in the repo.
.*
!.gitignore
!.github/
!.github/**

# Optional tracked env template (uncomment if you add one):
# !.env.example

# --- Flowpact local outputs ---
export-eng.json
**/export-eng.json
pact.yaml
!examples/**/pact.yaml
!src/flowpact/resources/templates/*.yaml
